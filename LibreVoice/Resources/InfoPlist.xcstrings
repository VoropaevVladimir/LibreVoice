    "NSMicrophoneUsageDescription" : {
      "comment" : "Shown in the system microphone-permission dialog.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LibreVoice needs microphone access to turn your speech into text. Audio is processed entirely on this Mac and never leaves your device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LibreVoice нужен доступ к микрофону, чтобы превращать вашу речь в текст. Звук обрабатывается полностью на этом Mac и никогда не покидает устройство."
          }
        }
      }
    }
