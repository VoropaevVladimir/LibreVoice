      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано"
          }
        }
      }
    },
    "Copies an instruction for an external AI. LibreVoice contacts nothing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирует инструкцию для внешнего ИИ. LibreVoice никуда не обращается."
