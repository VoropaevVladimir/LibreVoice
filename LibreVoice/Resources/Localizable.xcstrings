    "Dictation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка"
          }
        }
      }
    },
    "Dictation mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим диктовки"
          }
        }
      }
    },
    "Dictation needs a speech model on this Mac. Download one in Settings › Models — it's a one-time download, and everything stays offline.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для диктовки нужна модель распознавания на этом Mac. Загрузите её в «Настройки › Модели» — это одноразовая загрузка, и всё остаётся офлайн."
          }
        }
      }
    },
    "Dictation status": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус диктовки"
          }
        }
      }
    },
    "Disabled — the language model is not used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
