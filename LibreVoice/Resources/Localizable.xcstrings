    "Error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка"
          }
        }
      }
    },
    "Every engine transcribes on this Mac. Nothing is uploaded, whichever one you choose.": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой движок распознаёт на этом Mac. Ничего не загружается в сеть, какой бы вы ни выбрали."
          }
        }
      }
    },
    "Everything is transcribed on this Mac. Nothing is uploaded, stored, or sent anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё распознаётся на этом Mac. Ничего не загружается, не сохраняется и никуда не отправляется."
          }
        }
      }
    },
    "Everything on this screen runs on this Mac. Your text is never sent anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё на этом экране работает на этом Mac. Ваш текст никуда не отправляется."
          }
        }
      }
    },
    "Examples": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примеры"
          }
        }
      }
    },
    "Export the profile as a plain .md file encoded as UTF-8.": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте профиль как обычный файл .md в кодировке UTF-8."
          }
        }
      }
    },
    "Fast": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый"
          }
        }
      }
    },
    "Fast and accurate, running on the Neural Engine. 25 languages including Russian.": {
      "localizations": {
        "ru": {
